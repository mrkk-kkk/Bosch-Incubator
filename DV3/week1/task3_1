module pwm #(parameter WIDTH = 8 )

          (input  logic clk,
           input  logic reset,
           input  logic [WIDTH:0]cycle_duty,
           output logic pwm_out
          );
    
  logic [WIDTH-1:0] count;
    
  always_ff @(posedge clk) begin
   if (reset)
      count <= '0;
   else
      count <= count + 1;
   
    if (count < cycle_duty)
      pwm_out <= 1;
   else
      pwm_out <= '0;
  end
  
    
endmodule
